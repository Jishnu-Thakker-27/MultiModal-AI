# Backend Environment Variables
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/study_companion
SQLITE_FALLBACK=true

# PROVIDER PRIORITY (Comma-separated order of failover)
LLM_PROVIDER_PRIORITY=openai,gemini,openrouter,ollama

# 1. OPENAI PROVIDER
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# 2. GOOGLE GEMINI PROVIDER
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# 3. OPENROUTER PROVIDER
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# 4. LOCAL OLLAMA PROVIDER (OFFLINE FALLBACK)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_ENABLED=false

# Configurable Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50
